#!/usr/bin/env bash
# Fast checks before every commit. The full suite runs in pre-push and CI.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

branch="$(git symbolic-ref --short -q HEAD || true)"
if [[ "${branch}" == "main" ]]; then
  echo "ERROR: do not commit directly on 'main'. Create a branch: git switch -c feat/your-change" >&2
  exit 1
fi

# No merge-conflict markers or oversized files in staged changes.
if git diff --cached -U0 | grep -q -E '^\+(<<<<<<<|>>>>>>>) '; then
  echo "ERROR: staged changes contain merge-conflict markers." >&2
  exit 1
fi
while IFS= read -r f; do
  [[ -f "$f" ]] || continue
  if (( $(wc -c < "$f") > 1048576 )); then
    echo "ERROR: $f is larger than 1 MiB; large artifacts do not belong in git." >&2
    exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=AM)

# Obvious secrets (private keys) must never be committed.
if git diff --cached -U0 | grep -q -E '^\+.*-----BEGIN ([A-Z]+ )?PRIVATE KEY-----'; then
  echo "ERROR: staged changes contain a private key." >&2
  exit 1
fi

if git diff --cached --name-only | grep -q -E '\.rs$'; then
  cargo fmt --all --check || { echo "ERROR: run 'cargo fmt --all'." >&2; exit 1; }
fi
